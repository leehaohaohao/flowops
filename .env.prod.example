# FlowOps 生产环境变量（复制此文件为 .env.prod 并填入真实值）
DB_URL=jdbc:mysql://YOUR_HOST:3306/flowops?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=your_password_here
JWT_SECRET=your_jwt_secret_here
# 子节点通信监听：跨机器部署必须设为子节点可达地址（容器内建议 0.0.0.0），并放通端口与防火墙
# 默认 127.0.0.1 只允许本机子节点连接
NEXA_MASTER_HOST=0.0.0.0
NEXA_MASTER_PORT=9090
