# FlowOps 生产环境变量（复制此文件为 .env.prod 并填入真实值）
DB_URL=jdbc:mysql://YOUR_HOST:3306/flowops?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=your_password_here
JWT_SECRET=your_jwt_secret_here
# 产物下载（远程部署）：主节点 HTTP 地址（子节点需能访问）+ 共享密钥（生产建议配置，与子节点保持一致）
ARTIFACT_BASE_URL=http://127.0.0.1:8080
ARTIFACT_TOKEN=change_me_shared_secret
